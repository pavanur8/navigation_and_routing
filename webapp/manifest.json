{
  "_version": "1.90.0",
  "sap.app": {
    "id": "com.pavan.app.navigationandrouting",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.34.0",
      "toolsId": "7f62ac7a-ce60-47e4-aeeb-c91759b92cd2"
    },
    "dataSources": {
        "zstudents" : {
            "type": "JSON",
            "uri": "model/students.json"
        }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.pavan.app.navigationandrouting.i18n.i18n"
        }
      },
      "zstudentsModel" :{
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "zstudents" 
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "flip",
        "type": "View",
        "viewType": "XML",
        "path": "com.pavan.app.navigationandrouting.view",
        "async": true,
        "viewPath": "com.pavan.app.navigationandrouting.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": "",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name":"RouteAbout",
          "pattern":"about/{name}",
          "target": [
            "TargetAbout"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "name": "Home"
        },
        "TargetAbout": {
          "id": "About",
          "name": "About"
        }
      }
    },
    "rootView": {
      "viewName": "com.pavan.app.navigationandrouting.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
